# Quest Analytics RAG Assistant - Document Processing Worker
# Container for background document ingestion with OCR and PDF processing

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
ENV PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    poppler-utils \
    tesseract-ocr \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
# Install CPU-only torch first so sentence-transformers reuses it instead of
# resolving PyPI's default CUDA-enabled build (saves several GB / build time).
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

ENV OPENSEARCH_HOST=http://opensearch:9200 \
    OPENSEARCH_INDEX=quest-research \
    OPENSEARCH_TLS_VERIFY=false \
    EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

CMD ["python", "scripts/ingest_watch.py"]
